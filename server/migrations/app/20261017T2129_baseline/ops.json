  {
    "id": "foreignKey.ratings.ratings_book_id_fkey",
    "label": "Add foreign key \"ratings_book_id_fkey\" on \"ratings\"",
    "operationClass": "additive",
    "target": {
      "id": "postgres",
      "details": {
        "schema": "public",
        "objectType": "foreignKey",
        "name": "ratings_book_id_fkey",
        "table": "ratings"
      }
    },
    "precheck": [
      {
        "description": "ensure FK \"ratings_book_id_fkey\" does not exist",
        "sql": "SELECT NOT EXISTS (SELECT 1 AS \"one\" FROM \"pg_constraint\" AS \"c\" INNER JOIN \"pg_namespace\" AS \"n\" ON \"n\".\"oid\" = \"c\".\"connamespace\" WHERE (\"c\".\"conname\" = $1 AND \"n\".\"nspname\" = $2 AND \"c\".\"conrelid\" = to_regclass($3))) AS \"result\"",
        "params": [
          "ratings_book_id_fkey",
          "public",
          "\"public\".\"ratings\""
        ]
      }
    ],
    "execute": [
      {
        "description": "add FK \"ratings_book_id_fkey\"",
        "sql": "ALTER TABLE \"public\".\"ratings\"\nADD CONSTRAINT \"ratings_book_id_fkey\"\nFOREIGN KEY (\"book_id\")\nREFERENCES \"public\".\"books\" (\"id\")\nON DELETE CASCADE"
      }
    ],
    "postcheck": [
      {
        "description": "verify FK \"ratings_book_id_fkey\" exists",
        "sql": "SELECT EXISTS (SELECT 1 AS \"one\" FROM \"pg_constraint\" AS \"c\" INNER JOIN \"pg_namespace\" AS \"n\" ON \"n\".\"oid\" = \"c\".\"connamespace\" WHERE (\"c\".\"conname\" = $1 AND \"n\".\"nspname\" = $2 AND \"c\".\"conrelid\" = to_regclass($3))) AS \"result\"",
        "params": [
          "ratings_book_id_fkey",
          "public",
          "\"public\".\"ratings\""
        ]
      }
    ]
  }
