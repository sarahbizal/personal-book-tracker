    ],
    "execute": [
      {
        "description": "create table \"books\"",
        "sql": "CREATE TABLE \"public\".\"books\" (\n  \"author\" text NOT NULL,\n  \"cover_image_url\" text,\n  \"genre\" text NOT NULL,\n  \"id\" SERIAL NOT NULL,\n  \"read_status\" text DEFAULT 'want to read' NOT NULL,\n  \"title\" text NOT NULL,\n  CONSTRAINT \"books_pkey\" PRIMARY KEY (\"id\"),\n  CONSTRAINT \"books_read_status_check\" CHECK ((read_status = ANY (ARRAY['want to read'::text, 'reading'::text, 'read'::text])))\n)",
        "params": []
      }
    ],
    "postcheck": [
      {
        "description": "verify table \"books\" exists",
        "sql": "SELECT (to_regclass($1)) IS NOT NULL AS \"result\"",
        "params": [
          "\"public\".\"books\""
        ]
      }
    ]
  },
  {
    "id": "table.ratings",
