        ]
      }
    ],
    "execute": [
      {
        "description": "create table \"ratings\"",
        "sql": "CREATE TABLE \"public\".\"ratings\" (\n  \"book_id\" int4 NOT NULL,\n  \"book_review_text\" text,\n  \"date_finished\" date,\n  \"id\" SERIAL NOT NULL,\n  \"rating\" int4,\n  CONSTRAINT \"ratings_pkey\" PRIMARY KEY (\"id\"),\n  CONSTRAINT \"ratings_rating_check\" CHECK (((rating >= 1) AND (rating <= 5)))\n)",
        "params": []
      }
    ],
    "postcheck": [
