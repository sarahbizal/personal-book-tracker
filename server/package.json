{
  "name": "personal-book-tracker",
  "version": "1.0.0",
  "description": "*Personal Book Tracker*\r As a self proclaimed book lover, I keep coming back to this idea of a book tracker to tinker with. \r This time I'm focusing on the following stack:\r - Typescript\r - Express\r - PostgreSQL\r - React",
  "main": "index.js",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "contract:emit": "prisma contract emit",
    "db:migrate": "prisma db migrate --advance-ref db",
    "db:migrate:test": "DOTENV_CONFIG_PATH=.env.test DOTENV_CONFIG_OVERRIDE=true prisma db migrate",
    "db:status": "prisma migration status",
    "db:status:test": "DOTENV_CONFIG_PATH=.env.test DOTENV_CONFIG_OVERRIDE=true prisma migration status"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sarahbizal/personal-book-tracker.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "bugs": {
    "url": "https://github.com/sarahbizal/personal-book-tracker/issues"
  },
  "homepage": "https://github.com/sarahbizal/personal-book-tracker#readme",
  "dependencies": {
    "@prisma/orm-postgres": "8.0.0-rc.17",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "temporal-polyfill": "^1.0.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@prisma/cli-engine": "0.7.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.4.0",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "^4.1.11",
    "prisma": "8.0.0-rc.22",
    "supertest": "^7.2.2",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
